/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# 이미지는 같은 이름으로 교체할 수 있도록 하루만 캐시합니다 (교체 후 늦어도 다음 날 반영)
/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/video/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/sitemap.xml
  Cache-Control: public, max-age=3600

/rss.xml
  Cache-Control: public, max-age=3600

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# CSS·JS는 html에서 ?v=버전 값을 붙여 부르므로, 새로 배포하면 바로 새 파일을 받습니다
/css/*
  Cache-Control: public, max-age=300

/js/*
  Cache-Control: public, max-age=300

/admin
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

/admin.html
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

# 정식 주소(socialfactory.co.kr)만 검색에 나오도록 Cloudflare 기본 주소(*.pages.dev)는 수집하지 않게 합니다
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex

/api/*
  X-Robots-Tag: noindex
  Cache-Control: no-store

# 토스프론트 플러그인 원본 · 알림 발송기 코드는 검색에 나오지 않게 합니다 (실제 플러그인은 토스 개발자센터에 ZIP 으로 올림)
/toss-front-plugin/*
  X-Robots-Tag: noindex, nofollow

/workers/*
  X-Robots-Tag: noindex, nofollow
