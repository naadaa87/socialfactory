API_ORIGIN=https://your-socialfactory-site.example
# Same long random secret as the Pages environment. Never commit it.
SPACECLOUD_WORKER_TOKEN=
# Enable only after `npm run login` and `npm run check` succeed.
SPACECLOUD_ALLOW_WRITES=false
SPACECLOUD_PROFILE_DIR=.profile
SPACECLOUD_ACCOUNT_LABEL=소셜팩토리 건대 (초특가)
SPACECLOUD_HEADLESS=false
SPACECLOUD_POLL_MS=3000
